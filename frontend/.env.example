# For local development without Docker
VITE_API_URL=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001

# Leave empty in Docker Compose so the browser uses the current origin
VITE_PUBLIC_ORIGIN=

# Optional WebRTC override
VITE_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_WEBRTC_TURN_URLS=
VITE_WEBRTC_TURN_USERNAME=
VITE_WEBRTC_TURN_CREDENTIAL=
VITE_WEBRTC_ENABLE_OPENRELAY_FALLBACK=true